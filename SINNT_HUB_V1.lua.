local function eggNamed(inst)
    if not (inst:IsA("Model") or inst:IsA("BasePart")) then return false end
    local name = string.lower(inst.Name)
    if not (name:find("egg", 1, true) or name:find("telur", 1, true)) then
        return false
    end
    if inst:IsDescendantOf(player.Character or Workspace.Terrain) then return false end
    local parent = inst.Parent
    while parent and parent ~= Workspace do
        if (parent:IsA("Model") or parent:IsA("BasePart")) then
            local pname = string.lower(parent.Name)
            if pname:find("egg", 1, true) or pname:find("telur", 1, true) then
                return false
            end
        end
        parent = parent.Parent
    end
    return true
end
local function getTargetPart(inst)
    if not inst or not inst.Parent then return nil end
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end
local function destroyEggVisual(inst)
    local objects = eggVisuals[inst]
    if not objects then return end
    for _, obj in ipairs(objects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    eggVisuals[inst] = nil
end
local function eggCount()
    local count = 0
    for inst in pairs(eggVisuals) do
        if inst and inst:IsDescendantOf(Workspace) then
            count = count + 1
        else
            destroyEggVisual(inst)
        end
    end
    return count
end
local function addEggVisual(inst)
    if not alive or not state.eggESP or eggVisuals[inst] or not eggNamed(inst) then return end
    if eggCount() >= MAX_EGG_MARKERS then return end
    local part = getTargetPart(inst)
