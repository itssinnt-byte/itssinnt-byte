local eggScanToken = 0
local function refreshEggVisuals()
    eggScanToken = eggScanToken + 1
    local token = eggScanToken
    clearEggVisuals()
    if not state.eggESP then return end
    task.spawn(function()
        for i, inst in ipairs(Workspace:GetDescendants()) do
            if not alive or token ~= eggScanToken or not state.eggESP then return end
            if eggNamed(inst) then addEggVisual(inst) end
            if i % 300 == 0 then task.wait() end
        end
    end)
end
local function findNearestEgg()
    local root = rootPart()
    if not root then return nil, nil end
    local chosen, chosenPart
    local nearest = math.huge
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if eggNamed(inst) then
            local part = getTargetPart(inst)
            if part then
                local distance = (part.Position - root.Position).Magnitude
                if distance < nearest then
                    nearest, chosen, chosenPart = distance, inst, part
                end
            end
        end
    end
    return chosen, chosenPart
end

