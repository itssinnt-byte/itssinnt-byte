local function teleportToEgg()
    local egg, target = findNearestEgg()
    local root = rootPart()
    if not root then notice("Karakter belum siap.") return end
    if not egg or not target then notice("Objek bernama Egg/Telur tidak ditemukan.") return end
    local ok = pcall(function()
        root.CFrame = CFrame.new(target.Position + Vector3.new(0, 4, 0))
    end)
    notice(ok and ("Percobaan teleport: " .. egg.Name) or "Teleport ditolak oleh client.")
end
local function fireNearestPrompt()
    if type(fireproximityprompt) ~= "function" then
        notice("Executor tidak menyediakan fireproximityprompt.")
        return
    end
    local root = rootPart()
    if not root then notice("Karakter belum siap.") return end
    local bestPrompt, bestDist = nil, 12
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("ProximityPrompt") and inst.Enabled then
            local p = inst.Parent
            if p and p:IsA("Attachment") then p = p.Parent end
            if p and p:IsA("BasePart") then
                local dist = (p.Position - root.Position).Magnitude
                if dist < bestDist then bestPrompt, bestDist = inst, dist end
            end
        end
    end
    if not bestPrompt then notice("Tidak ada ProximityPrompt di radius 12 studs.") return end
    local ok, err = pcall(function() fireproximityprompt(bestPrompt) end)
    notice(ok and "Prompt lokal dicoba dijalankan." or ("Prompt gagal: " .. tostring(err)))
end
