        actionRow("Hapus Hub", "Tutup dan bersihkan semua marker", function()
            destroyHub()
        end)
    end
end

-- Event hooks are per execution, and all disconnected on Destroy().
track(Players.PlayerAdded:Connect(function(plr)
    track(plr.CharacterAdded:Connect(function()
        task.wait(0.5)
        addPlayerVisual(plr)
    end))
    if state.playerESP then addPlayerVisual(plr) end
end))
for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= player then
        track(plr.CharacterAdded:Connect(function()
            task.wait(0.5)
            addPlayerVisual(plr)
        end))
    end
end
track(Players.PlayerRemoving:Connect(function(plr)
    deletePlayerVisual(plr)
end))
track(player.CharacterAdded:Connect(function()
    restoreCollisions()
    task.wait(0.35)
    if alive then applyMovement() end
end))
track(UserInputService.JumpRequest:Connect(function()
    if not alive or not state.infiniteJump then return end
    local h = humanoid()
    if h and h.Health > 0 then pcall(function() h:ChangeState(Enum.HumanoidStateType.Jumping) end) end
end))
track(Workspace.DescendantAdded:Connect(function(inst)
    if not alive then return end
    if state.eggESP and eggNamed(inst) then addEggVisual(inst) end
    if state.fpsSaver and (inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")) then
        setVisual(inst, "Enabled", false)
    end
end))
track(player.Idled:Connect(function()
    if not alive or not state.antiAFK then return end
    pcall(function()
        local virtualUser = game:GetService("VirtualUser")
        virtualUser:CaptureController()
        virtualUser:ClickButton2(Vector2.new(0, 0))
    end)
end))
local stepTime = 0
track(RunService.Heartbeat:Connect(function(dt)
    if not alive then return end
    if state.noclip then applyNoclip() end
    stepTime = stepTime + dt
    if stepTime >= 0.55 then
        stepTime = 0
        if state.speed or state.jump then applyMovement() end
        if state.playerESP then
            local myRoot = rootPart()
            if myRoot then
                for plr, objects in pairs(playerVisuals) do
                    local otherRoot = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    local label = objects[3]
                    if otherRoot and label and label.Parent then
                        local distance = math.floor((otherRoot.Position - myRoot.Position).Magnitude)
                        label.Text = plr.DisplayName .. " [" .. distance .. " studs]"
                    end
                end
            end
        end
    end
end))

-- Ensure shutdown doesn't touch GUI or effects belonging to other scripts.
destroyHub = function()
    if not alive then return end
    alive = false
    for key in pairs(state) do state[key] = false end
    applyMovement()
    restoreCollisions()
    refreshPlayerVisuals()
    refreshEggVisuals()
    restoreVisuals()
    for _, conn in ipairs(pageConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(pageConnections)
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(connections)
    if mainGui and mainGui.Parent then mainGui:Destroy() end
    if env.SINNT_HUB_V1 and env.SINNT_HUB_V1.Destroy == destroyHub then
        env.SINNT_HUB_V1 = nil
    end
end
env.SINNT_HUB_V1 = {Destroy = destroyHub, Version = "1.0.0"}

applyMovement()
if state.fpsSaver then applyFpsSaver() end
if state.playerESP then refreshPlayerVisuals() end
if state.eggESP then refreshEggVisuals() end
renderTab()
notice("SINNT HUB V1 aktif • tanpa key.")
